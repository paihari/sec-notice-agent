# SEC requires a descriptive User-Agent identifying you (name/app + contact email).
# See https://www.sec.gov/os/webmaster-faq#developers
SEC_USER_AGENT="SEC Notice Agent (hpai.bantwal@gmail.com)"

# SQLite database location (relative paths are resolved from the project root).
DATABASE_URL="sqlite:///sec_notice.db"

# Where downloaded filing documents are stored on disk.
DATA_DIR="data/filings"

# --- Phase 3: AI analyst (Claude Agent SDK) ---
# Required for the materiality agent. Read from env; never commit your real key.
ANTHROPIC_API_KEY="sk-ant-..."
# Model the analyst uses.
ANALYST_MODEL="claude-opus-4-8"
# Only these forms get the full cross-check analysis (comma-separated).
MATERIAL_FORMS="8-K,10-K,10-Q"
# Materiality score (0-100) at/above which a filing is flagged for notification.
MATERIALITY_THRESHOLD="60"
